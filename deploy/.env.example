# 复制成 .env 后按实际情况修改：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# ===== 中间件：容器用的是 host 网络，一律走回环 =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

NACOS_ADDR=127.0.0.1:8848

# ES 已下线，activity 搜索会自动降级到 MySQL 模糊查询，这里留空也不影响启动
ES_URIS=http://127.0.0.1:9200

# ===== 注册到 Nacos 的地址 =====
# host 网络下必须显式指定，否则 Nacos 客户端可能探测到 docker0 的 172.17.0.1，
# 导致网关调用时绕一层网桥
SPRING_CLOUD_NACOS_DISCOVERY_IP=127.0.0.1

# ===== 安全 =====
# 用 openssl rand -base64 32 生成，别用代码里的默认占位值
JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
INTERNAL_TOKEN=CHANGE_ME_openssl_rand_base64_32

# 优雅关闭：docker stop 时先让 Spring 关连接池再退出，避免 MySQL 侧残留连接
SERVER_SHUTDOWN=graceful

# jar 里含 application-dev.yml（OSS 密钥），所以 profile 保持 dev
SPRING_PROFILES_ACTIVE=dev

# ===== JVM：4G 机器上 8 个服务共享，堆压到 128m =====
# SerialGC 在小堆下比 G1 省 20~30MB 常驻内存
JAVA_OPTS=-Xms128m -Xmx128m -XX:MaxMetaspaceSize=96m -Xss512k -XX:+UseSerialGC
